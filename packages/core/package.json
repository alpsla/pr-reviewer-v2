{
  "name": "@pr-reviewer/core",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node build-complete.js || node build-space-saving.js",
    "build:strict": "tsup",
    "build:js": "tsup src/index.ts --format cjs,esm --no-dts --clean",
    "build:dts": "node build-declarations.js || node build-declarations-fix.js",
    "build:fix": "node fix-specific-errors.js",
    "build:space-saving": "tsup src/index.ts --format cjs,esm --no-dts --clean && node build-declarations-fix.js",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.ts*\"",
    "test": "jest --config jest.config.ts",
    "test:simplified": "jest --config jest.config.simplified.js",
    "test:skip-failing": "jest --config jest.skip-failing.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "dts": {
      "resolve": true,
      "entry": "src/index.ts"
    },
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "skipNodeModulesBundle": true,
    "target": "es2020",
    "outDir": "dist"
  },
  "dependencies": {
    "@gitbeaker/rest": "^42.1.0",
    "@octokit/core": "4.2.4",
    "@octokit/request-error": "3.0.3",
    "@octokit/rest": "19.0.13",
    "@supabase/supabase-js": "^2.39.3",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@gitbeaker/core": "^42.1.0",
    "@gitbeaker/node": "^35.8.1",
    "@octokit/types": "9.3.2",
    "@types/jest": "^29.5.11",
    "@types/next": "^9.0.0",
    "@types/node": "^20.17.19",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "node-mocks-http": "^1.12.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
