{
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_"
    }],
    "@typescript-eslint/ban-ts-comment": ["error", {
      "ts-ignore": false,
      "ts-expect-error": "allow-with-description"
    }]
  }
}
